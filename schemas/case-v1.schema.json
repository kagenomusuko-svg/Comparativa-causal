{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case-v1",
  "$ref": "#/$defs/case",
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "reference_event",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "reference_event": {
          "type": "string",
          "pattern": "\\S"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "act",
            "event",
            "participant",
            "condition",
            "relation",
            "sequence",
            "source",
            "proposition",
            "hypothesis",
            "support",
            "contradiction",
            "mechanism",
            "evidence",
            "absence",
            "assumption"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "refs": {
          "$ref": "#/$defs/labels"
        },
        "state": {
          "enum": [
            "accredited",
            "refuted",
            "disputed",
            "unknown",
            "pending"
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "relation",
              "target"
            ],
            "properties": {
              "relation": {
                "enum": [
                  "asserted_by",
                  "supports",
                  "contradicts",
                  "about",
                  "participates_in"
                ]
              },
              "target": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          },
          "minItems": 0
        },
        "locator": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
