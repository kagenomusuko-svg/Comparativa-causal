{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "external-engines-v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "case_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "case_id",
          "engine",
          "mathematical_version",
          "software_version",
          "operation",
          "domain_of_validity",
          "status",
          "effective_input",
          "effective_options",
          "diagnostics",
          "steps",
          "result"
        ],
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "case_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "engine": {
            "type": "string",
            "pattern": "\\S"
          },
          "mathematical_version": {
            "type": "string",
            "pattern": "\\S"
          },
          "software_version": {
            "type": "string",
            "pattern": "\\S"
          },
          "operation": {
            "type": "string",
            "pattern": "\\S"
          },
          "domain_of_validity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "success",
              "insufficient_data",
              "invalid_model",
              "not_identifiable",
              "undefined_operation",
              "limit_exceeded",
              "execution_error"
            ]
          },
          "effective_input": {
            "type": "object"
          },
          "effective_options": {
            "type": [
              "object",
              "null"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "trace": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "scope",
                  "dependency_order",
                  "elements"
                ],
                "properties": {
                  "scope": {
                    "const": "declared_inputs"
                  },
                  "dependency_order": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "minItems": 0
                  },
                  "elements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "pointer",
                        "depends_on",
                        "basis"
                      ],
                      "properties": {
                        "pointer": {
                          "type": "string",
                          "pattern": "^/"
                        },
                        "depends_on": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^/"
                          },
                          "minItems": 0
                        },
                        "basis": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "kind",
                              "ref"
                            ],
                            "properties": {
                              "kind": {
                                "enum": [
                                  "document",
                                  "assertion",
                                  "hypothesis",
                                  "assumption",
                                  "derived"
                                ]
                              },
                              "ref": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "additionalProperties": false
                          },
                          "minItems": 1
                        },
                        "derivation": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 0
                  },
                  "mode": {
                    "enum": [
                      "strict",
                      "compatible"
                    ]
                  },
                  "coverage": {
                    "type": "object",
                    "required": [
                      "complete",
                      "elements"
                    ],
                    "properties": {
                      "complete": {
                        "type": "boolean"
                      },
                      "elements": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "pointer",
                            "record",
                            "coverage",
                            "basis_kinds"
                          ],
                          "properties": {
                            "pointer": {
                              "type": "string",
                              "pattern": "^/"
                            },
                            "record": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^/"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "coverage": {
                              "enum": [
                                "individual",
                                "grouped",
                                "missing"
                              ]
                            },
                            "basis_kinds": {
                              "type": "array",
                              "items": {
                                "enum": [
                                  "document",
                                  "assertion",
                                  "hypothesis",
                                  "assumption",
                                  "derived"
                                ]
                              },
                              "minItems": 0
                            }
                          },
                          "additionalProperties": false
                        },
                        "minItems": 0
                      }
                    },
                    "additionalProperties": false
                  },
                  "provenance_status": {
                    "const": "declared_unverified"
                  },
                  "execution": {
                    "type": "object",
                    "required": [
                      "status",
                      "outputs"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "exact",
                          "conservative",
                          "unknown"
                        ]
                      },
                      "outputs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "pointer",
                            "dependency",
                            "inputs",
                            "operations",
                            "intermediates"
                          ],
                          "properties": {
                            "pointer": {
                              "type": "string",
                              "pattern": "^/"
                            },
                            "dependency": {
                              "enum": [
                                "exact",
                                "conservative",
                                "unknown"
                              ]
                            },
                            "inputs": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^/"
                              },
                              "minItems": 0
                            },
                            "operations": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 0
                            },
                            "intermediates": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "pointer",
                                  "dependency"
                                ],
                                "properties": {
                                  "pointer": {
                                    "type": "string",
                                    "pattern": "^/"
                                  },
                                  "dependency": {
                                    "enum": [
                                      "exact",
                                      "conservative",
                                      "unknown"
                                    ]
                                  }
                                },
                                "additionalProperties": false
                              },
                              "minItems": 0
                            },
                            "input_scope": {
                              "type": "string",
                              "pattern": "^/"
                            }
                          },
                          "additionalProperties": false
                        },
                        "minItems": 0
                      },
                      "observed_reads": {
                        "type": "object",
                        "required": [
                          "dependency",
                          "inputs",
                          "scope"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "dependency": {
                            "const": "exact"
                          },
                          "inputs": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^/"
                            }
                          },
                          "scope": {
                            "const": "instrumented_value_lookups"
                          }
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reconstruction_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    }
  },
  "additionalProperties": false
}
