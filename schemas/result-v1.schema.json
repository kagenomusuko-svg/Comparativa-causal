            {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "joint_masses": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
          }
        },
        "soft_evidence_certificate": {
          "$ref": "#/$defs/bn_soft_certificate"
        }
      }
    }
  }
}
