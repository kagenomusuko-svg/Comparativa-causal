                ],
                "properties": {
                  "structure_certificate": {
                    "type": "object",
                    "required": [
                      "effective_parents",
                      "pattern_certificates",
                      "evidence_paths",
                      "nodes_without_tables"
                    ],
                    "properties": {
                      "effective_parents": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 0
                        }
                      },
                      "pattern_certificates": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/bn_pattern_certificate"
                        }
                      },
                      "evidence_paths": {
                        "type": "object",
                        "additionalProperties": {
                          "enum": [
                            "direct",
                            "circumstantial",
                            "unclassified"
                          ]
                        }
                      },
                      "nodes_without_tables": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 0
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "ness"
          },
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "ness_cause",
