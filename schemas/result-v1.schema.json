                  },
                  "reconstructions": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "pearl"
          },
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "event"
                ],
                "properties": {
                  "event": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "probability"
                ],
                "properties": {
                  "probability": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "bayesian"
          },
          "status": {
            "const": "success"
          },
          "operation": {
            "const": "structure"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "structure_certificate"
            ],
            "properties": {
              "structure_certificate": {
                "type": "object",
                "required": [
                  "effective_parents",
                  "pattern_certificates",
                  "evidence_paths",
                  "nodes_without_tables"
                ],
                "properties": {
                  "effective_parents": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0
                    }
                  },
                  "pattern_certificates": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bn_pattern_certificate"
                    }
                  },
                  "evidence_paths": {
                    "type": "object",
                    "additionalProperties": {
                      "enum": [
                        "direct",
                        "circumstantial",
                        "unclassified"
                      ]
                    }
                  },
                  "nodes_without_tables": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
