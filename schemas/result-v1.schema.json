              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "bn_soft_certificate": {
      "type": "object",
      "required": [
        "node",
        "method",
        "conditioning",
        "target",
        "weights"
