                          "properties": {
                            "evidence": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  "evidence_sensitivity": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/$defs/bn_observation"
