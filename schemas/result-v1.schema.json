          "engine": {
            "const": "bayesian"
          },
          "status": {
            "const": "success"
          },
          "operation": {
            "const": "evidence_sequence"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "evidence_probability",
              "prior",
              "posterior",
              "sequence"
            ],
            "properties": {
              "evidence_probability": {
                "type": "string",
                "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
              },
              "prior": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                }
              },
              "posterior": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sequence": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/bn_observation"
                    },
                    {
                      "type": "object",
                      "required": [
                        "evidence"
                      ],
                      "properties": {
                        "evidence": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "bayesian"
          },
          "status": {
            "const": "success"
          },
          "operation": {
            "const": "evidence_sensitivity"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "evidence_probability",
              "prior",
              "posterior",
              "evidence_sensitivity",
              "evidence_sensitivity_ranges"
            ],
            "properties": {
              "evidence_probability": {
                "type": "string",
                "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
              },
              "prior": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                }
              },
              "posterior": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_sensitivity": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/bn_observation"
                  }
                }
              },
              "evidence_sensitivity_ranges": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "min",
                          "max"
                        ],
                        "properties": {
                          "min": {
                            "type": "string",
                            "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
