        },
        "conditioning": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
          }
        }
      }
    },
    "bn_observation": {
      "type": "object",
      "required": [
        "evidence_probability",
        "prior",
        "posterior"
      ],
      "properties": {
        "evidence_probability": {
          "type": "string",
