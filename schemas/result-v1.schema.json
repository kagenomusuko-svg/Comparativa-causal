                    }
                  },
                  "evidence_sensitivity_ranges": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "min",
                              "max"
                            ],
                            "properties": {
                              "min": {
                                "type": "string",
                                "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                              },
                              "max": {
                                "type": "string",
                                "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "pattern_certificates": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bn_pattern_certificate"
                    }
                  },
                  "joint_masses": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"
                    }
                  },
                  "soft_evidence_certificate": {
                    "$ref": "#/$defs/bn_soft_certificate"
